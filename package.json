{
  "name": "eslint-plugin-pet-peeves",
  "version": "0.1.0",
  "description": "Opinionated ESLint rules for keeping JavaScript expressions readable.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "npm run build && npm run typecheck && npm run test:run",
    "test:run": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joonarafael/eslint-plugin-pet-peeves.git"
  },
  "bugs": {
    "url": "https://github.com/joonarafael/eslint-plugin-pet-peeves/issues"
  },
  "homepage": "https://github.com/joonarafael/eslint-plugin-pet-peeves#readme",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
